# ============================================
# Gulliver Guide — Environment Variables
# ============================================

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/gulliver-guide

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Google Gemini API Key (required for itinerary generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (used for CORS in production)
CLIENT_URL=https://gulliverguide.de

# Port (Heroku sets this automatically)
PORT=3001

# Node environment
NODE_ENV=development
